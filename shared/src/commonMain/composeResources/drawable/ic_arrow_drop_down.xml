<!-- Duplicates app/src/main/res/drawable/ic_arrow_drop_down.xml (same
     path data), for expediency: Compose Multiplatform resources live in a
     separate module resource tree and can't reference the Android app
     module's res/drawable directly. The android:tint attribute of the
     original is dropped because its @color reference can't resolve here;
     Compose's Icon applies LocalContentColor instead. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M7,10l5,5 5,-5z" />
</vector>
